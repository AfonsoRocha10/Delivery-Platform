# Copy to docker/.env (ignored by Git) and fill in. Compose reads docker/.env automatically.

# Required: password of the PostgreSQL user "delivery", used by both services.
# It is applied only when the database volume is created; to change it later, run
# "docker compose -f docker/compose.yaml down -v" (deletes the data) or change it in PostgreSQL.
DB_PASSWORD=

# Optional: port of the API on this machine (default 8081).
APP_PORT=8081

# Optional: "demo" loads 300 sample deliveries into an empty database.
SPRING_PROFILES_ACTIVE=
