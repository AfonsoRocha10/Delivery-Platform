// Build pipeline for the delivery-service application.
// Run by the 'delivery-platform' job (pipeline/jenkins/casc/jobs.yml): automatically on every push
// to main that changes app/ or this file, or manually with "Build with Parameters".
pipeline {
    // Checkout and archiving run on the Jenkins server (it has git).
    // Maven stages run in a Java 25 container that shares the same workspace.
    agent any

    options {
        skipDefaultCheckout()
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    environment {
        // Keep Maven and its dependencies in the workspace: the build container user has no
        // usable home folder, and the workspace survives between builds, so this is also a cache.
        MAVEN_USER_HOME = "${WORKSPACE}/.m2"
        MAVEN_ARGS      = "-B -ntp -Dmaven.repo.local=${WORKSPACE}/.m2/repository"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def scmVars = checkout scm
                    // Commit of this build, for the image tag and labels in later stages.
                    env.GIT_COMMIT_FULL = scmVars.GIT_COMMIT
                    env.GIT_SHORT = scmVars.GIT_COMMIT.take(7)
                    // Name the build after the commit it built, e.g. "#7 cb03dc9".
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.GIT_SHORT}"
                }
            }
        }

        stage('Secret scan') {
            // The image's entrypoint is 'gitleaks'; clear it so Jenkins can keep the container alive.
            agent { docker { image 'zricethezav/gitleaks:v8.28.0'; args '--entrypoint='; reuseNode true } }
            steps {
                // Scan every commit (a secret deleted later is still in the history), not the
                // files on disk, which would include the Maven cache in .m2/. Exits 1 on a finding.
                // --log-opts=HEAD: only the history of the commit being built; the default (--all)
                // would also scan stale branches left in the workspace. --redact keeps secrets out of this log.
                sh '''
                    gitleaks git --log-opts=HEAD --redact --verbose --no-banner --no-color \
                        --report-format json --report-path gitleaks-report.json .
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'gitleaks-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('Compile') {
            agent { docker { image 'eclipse-temurin:25-jdk'; reuseNode true } }
            steps {
                dir('app') {
                    sh 'java -version && ./mvnw --version'
                    // clean: the workspace (and app/target/) is reused between builds, so without it a build
                    // could publish test reports or package files left over from a previous build of
                    // another commit. Test and Package then reuse this fresh output.
                    sh './mvnw clean compile'
                }
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'eclipse-temurin:25-jdk'
                    // Testcontainers starts PostgreSQL through the host's Docker engine: mount its socket
                    // and add the socket's group (root:root 660), as for the Jenkins container. Only this
                    // stage gets it. Temporary: to be replaced by a build agent with its own Docker
                    // engine, so builds no longer control the host's Docker.
                    args '-v /var/run/docker.sock:/var/run/docker.sock --group-add 0'
                    reuseNode true
                }
            }
            environment {
                // The containers Testcontainers starts publish their ports on the Docker host. From inside
                // this build container Testcontainers would use the bridge gateway (172.17.0.1), which
                // Docker Desktop does not route to published ports; host.docker.internal does.
                TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal'
            }
            steps {
                dir('app') {
                    sh './mvnw test'
                }
            }
            post {
                always {
                    junit 'app/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            agent { docker { image 'eclipse-temurin:25-jdk'; reuseNode true } }
            steps {
                dir('app') {
                    // Tests already ran in the Test stage.
                    sh './mvnw package -DskipTests'
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'app/target/*.jar', fingerprint: true
            }
        }

        stage('Image') {
            // Runs on the Jenkins server: it has the docker CLI (with Buildx) and the host's Docker
            // engine. Same app/Dockerfile as local builds, so the image is built the same way.
            steps {
                dir('app') {
                    // Tag: the commit, never "latest", so the tag says exactly which code is inside.
                    // Label ci-build: lets the cleanup below remove only images built by CI.
                    sh '''
                        docker build -t "delivery-service:${GIT_SHORT}" \
                          --label delivery-platform.ci-build=true \
                          --build-arg REVISION="${GIT_COMMIT_FULL}" \
                          --build-arg CREATED="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
                          .
                    '''
                }
                // Which image this build produced (tag and ID), archived with the build.
                sh '''
                    echo "delivery-service:${GIT_SHORT} $(docker image inspect --format '{{.Id}}' "delivery-service:${GIT_SHORT}")" > image.txt
                    cat image.txt
                '''
                // A file copy of the image for the scan, so the scanner needs no Docker access.
                sh 'docker save -o image.tar "delivery-service:${GIT_SHORT}"'
            }
            post {
                success {
                    archiveArtifacts artifacts: 'image.txt'
                }
                always {
                    // Remove CI images older than 7 days that no container uses; images without the
                    // label (e.g. delivery-service:local) are never touched.
                    sh 'docker image prune -af --filter label=delivery-platform.ci-build=true --filter until=168h'
                }
            }
        }

        stage('Image scan') {
            // Non-blocking (--exit-code 0): findings are reported, never fail the build; Phase 7 sets the
            // policy. Reads image.tar instead of the Docker socket. The vulnerability databases are
            // cached in the workspace (.trivy-cache), like the Maven cache, and only updated afterwards.
            agent { docker { image 'aquasec/trivy:0.76.2'; args '--entrypoint='; reuseNode true } }
            steps {
                // Full report (all severities) as JSON for the archive; the log shows HIGH and CRITICAL
                // findings only (--table-mode detailed: no summary row for each of the ~80 jars).
                sh '''
                    export TRIVY_DISABLE_VEX_NOTICE=1
                    trivy image --input image.tar --scanners vuln --exit-code 0 --no-progress \
                      --cache-dir .trivy-cache --format json --output trivy-report.json
                    trivy convert --scanners vuln --format table --table-mode detailed \
                      --severity HIGH,CRITICAL trivy-report.json
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.json', allowEmptyArchive: true
                    sh 'rm -f image.tar'
                }
            }
        }
    }

    post {
        success { echo "Built ${currentBuild.displayName}" }
        failure { echo 'Build failed: check the stage marked red and its log.' }
    }
}
