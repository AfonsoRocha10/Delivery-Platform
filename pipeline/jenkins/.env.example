# Environment variables for the Jenkins container (compose.yml).
# Copy this file to .env and replace the values. .env is ignored by Git; this file is committed.
#
# Format: NAME=value, no spaces around '=', no 'export'.
# Quote the value if it contains spaces or '#'. Write '$' as '$$' (Compose treats ${...} as a variable).

# Password of the 'admin' user created by casc/jenkins.yml.
JENKINS_ADMIN_PASSWORD=change-me

# Webhook relay channel that GitHub sends push events to. Create one with:
#   curl -s -o /dev/null -w '%{redirect_url}\n' https://smee.io/new
# Anyone with this URL can read the events sent to it: keep it out of Git.
SMEE_URL=https://smee.io/replace-me

# Secret GitHub signs each webhook event with; Jenkins rejects events without a valid signature.
# Use the same value in the repository's webhook settings. Generate one with:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
GITHUB_WEBHOOK_SECRET=change-me